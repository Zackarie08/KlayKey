# Local defaults. Copy to .env; supply credentials locally, never commit them.
NODE_ENV=development
PORT=3000
APP_NAME=KlayKey
# Optional canonical public URL for operator documentation.
BASE_URL=
# Production: private Railway reference to klaykey-mysql.MYSQL_URL.
DATABASE_URL=
# Local connection fields are used only when DATABASE_URL is empty.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=klaykeys
DB_PASSWORD=
DB_NAME=klaykeys_dev
# Generate at least 32 random characters; never share the value.
SESSION_SECRET=
SESSION_COOKIE_NAME=klaykey.sid
# Milliseconds; one day.
SESSION_MAX_AGE=86400000
# Set 1 only behind the Railway reverse proxy.
TRUST_PROXY=0
# Set true on the dedicated new Railway app for repeatable initial catalog seeding.
SEED_ON_START=false
