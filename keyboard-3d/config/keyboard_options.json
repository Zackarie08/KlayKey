    {"id":"switch-black","name":"Black Linear","type":"linear","mount":"MX","description":"Heavy, smooth linear travel with a deep, full thock. For typists who want more resistance.","audioAvailable":true,"visualColor":"#2A2A2E","priceAdjustment":0,"audioKind":"synthesized-approximation"},
    {"id":"switch-yellow","name":"Yellow Linear","type":"linear","mount":"MX","description":"Light, buttery linear with a soft, quick bottom-out. Easy on the fingers during long sessions.","audioAvailable":true,"visualColor":"#E3C23A","priceAdjustment":0,"audioKind":"synthesized-approximation"},
    {"id":"switch-silent","name":"Silent Red","type":"linear","mount":"MX","description":"Dampened linear that muffles the bottom-out. The quietest option for shared spaces.","audioAvailable":true,"visualColor":"#B84A5A","priceAdjustment":0,"audioKind":"synthesized-approximation"},
    {"id":"switch-speed","name":"Speed Silver","type":"linear","mount":"MX","description":"Short, light linear with a bright, crisp sound. Built for fast typing and gaming.","audioAvailable":true,"visualColor":"#C9CED6","priceAdjustment":0,"audioKind":"synthesized-approximation"},
    {"id":"switch-clear","name":"Clear Tactile","type":"tactile","mount":"MX","description":"A pronounced tactile bump with a firm, rounded sound. Clear feedback without any click.","audioAvailable":true,"visualColor":"#E8E8EC","priceAdjustment":0,"audioKind":"synthesized-approximation"},
    {"id":"switch-jade","name":"Jade Clicky","type":"clicky","mount":"MX","description":"A sharp, loud click with a crisp tactile bump. The most audible option in the lineup.","audioAvailable":true,"visualColor":"#2FA37A","priceAdjustment":0,"audioKind":"synthesized-approximation"},
